<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Off for the Phase 0 probe only: it reads the Tauri app's vault at
	     ~/Library/Application Support/com.venugopal.web-save and loads the
	     Rust dylib from target/. A shipped build gets the sandbox back plus
	     a bundled library and its own vault. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
