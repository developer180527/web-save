<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for API 26+. The launcher masks these two layers to whatever
  shape the device uses (circle, squircle, teardrop), which is why the plate is
  a flat colour here rather than the rounded-rect baked into the legacy
  mipmaps: letting the OEM mask a shape that already has its own corners is
  what produces the classic "rounded square inside a circle" look.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
